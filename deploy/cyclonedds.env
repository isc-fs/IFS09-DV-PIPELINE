# cyclonedds.env — installed to /etc/dv/cyclonedds.env by install_cyclonedds_tuning.sh
# (issue #21, docs/DDS_TUNING.md). Read by the dv-* systemd units (EnvironmentFile=-)
# and sourced by the dv_*.sh scripts. Delete this file to turn the Cyclone tuning off.
CYCLONEDDS_URI=file:///etc/dv/cyclonedds.xml
